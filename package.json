{
  "name": "clearance",
  "version": "0.1.0",
  "description": "A Mac control room for concurrent Claude Code pipeline runs.",
  "private": true,
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build && electron-builder --mac --dir",
    "dist:dmg": "pnpm build && electron-builder --mac dmg"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.19.1",
    "@types/node": "24.7.0",
    "chokidar": "4.0.3",
    "electron": "38.2.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.rolemodel.clearance",
    "productName": "Clearance",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/trayTemplate*.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "asar": true,
    "asarUnpack": [
      "dist/permission-server.mjs",
      "dist/permission-server.mjs.map"
    ]
  }
}
